{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/decorative/**",
              "components/feedback/**",
              "components/forms/**",
              "components/hero/**",
              "components/inline/**",
              "components/navigation/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIconTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|children|key|ref|className|style|children)$/]",
        "message": "<AppIconTile> doesn't accept that prop. Declared props: size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIconTile'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|large)$/]",
        "message": "<AppIconTile> size must be one of 'default' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pro|info)$/]",
        "message": "<Badge> variant must be one of 'pro' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|install)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'install'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandPaletteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:searchValue|size|children|key|ref|className|style|children)$/]",
        "message": "<CommandPaletteCard> doesn't accept that prop. Declared props: searchValue, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandPaletteCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg)$/]",
        "message": "<CommandPaletteCard> size must be one of 'xl' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandPaletteRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|icon|label|shortcut|key|ref|className|style|children)$/]",
        "message": "<CommandPaletteRow> doesn't accept that prop. Declared props: active, icon, label, shortcut."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevated|title|description|media|action|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: elevated, title, description, media, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|columns|key|ref|className|style|children)$/]",
        "message": "<FooterSection> doesn't accept that prop. Declared props: brand, columns."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroStripeBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|action|media|key|ref|className|style|children)$/]",
        "message": "<HeroStripeBand> doesn't accept that prop. Declared props: title, subtitle, action, media."
      },
      {
        "selector": "JSXOpeningElement[name.name='Keycap'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Keycap> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkInline'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|key|ref|className|style|children)$/]",
        "message": "<LinkInline> doesn't accept that prop. Declared props: href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|children|onClick|key|ref|className|style|children)$/]",
        "message": "<PillTab> doesn't accept that prop. Declared props: active, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:featured|name|price|priceSuffix|description|features|action|key|ref|className|style|children)$/]",
        "message": "<PricingTierCard> doesn't accept that prop. Declared props: featured, name, price, priceSuffix, description, features, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|onSignIn|ctaLabel|onCta|key|ref|className|style|children)$/]",
        "message": "<PrimaryNav> doesn't accept that prop. Declared props: brand, links, onSignIn, ctaLabel, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreExtensionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|author|description|action|key|ref|className|style|children)$/]",
        "message": "<StoreExtensionCard> doesn't accept that prop. Declared props: icon, name, author, description, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|placeholder|value|onChange|icon|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: variant, placeholder, value, onChange, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|search)$/]",
        "message": "<TextInput> variant must be one of 'default' | 'search'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
